name: Build Android APK

on:
  push:
    branches:
      - main
      - master
  pull_request:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  build:
    name: Build Debug and Release APKs
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      - name: Create Dummy Environment File
        run: |
          touch .env
          echo "GEMINI_API_KEY=dummy_key_for_ci_build" >> .env
          echo "KEYSTORE_PATH=${{ github.workspace }}/debug.keystore" >> .env
          echo "STORE_PASSWORD=android" >> .env
          echo "KEY_PASSWORD=android" >> .env

      - name: Make Gradle Executable
        run: chmod +x ./gradlew

      - name: Build Debug APK
        run: ./gradlew assembleDebug --stacktrace

      - name: Upload Debug APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: FamilyCare-Hub-Debug-APK
          path: app/build/outputs/apk/debug/*.apk
          retention-days: 30
